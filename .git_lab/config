[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = git@gitlab.com:comp-surf-sci/metal.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "spinel-tolerance"]
	remote = origin
	merge = refs/heads/spinel-tolerance
	vscode-merge-base = origin/spinel-tolerance
